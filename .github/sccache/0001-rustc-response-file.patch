+/// `CreateProcessW`'s command line limit, in UTF-16 units.
+#[cfg(windows)]
+const MAX_COMMAND_LINE: usize = 32_767;
+
+/// The arguments to spawn rustc with. We expand `@response` files while
+/// parsing, so a command line cargo kept short with one can be too long to
+/// spawn on Windows (os error 206); such arguments go back into a response
+/// file. Keep the returned path alive until rustc exits.
+pub(crate) fn spawn_arguments(
+    executable: &Path,
+    arguments: Vec<OsString>,
+) -> Result<(Vec<OsString>, Option<tempfile::TempPath>)> {
+    #[cfg(windows)]
+    return pack_arguments(executable, arguments, MAX_COMMAND_LINE);
+    #[cfg(not(windows))]
+    {
+        let _ = executable;
+        Ok((arguments, None))
+    }
+}
+
+#[cfg_attr(not(windows), allow(dead_code))]
+fn pack_arguments(
+    executable: &Path,
+    arguments: Vec<OsString>,
+    limit: usize,
+) -> Result<(Vec<OsString>, Option<tempfile::TempPath>)> {
+    // Upper bound after quoting: two quotes and a space per argument, and an
+    // escape for every backslash or quote.
+    let quoted = |s: &std::ffi::OsStr| {
+        let s = s.to_string_lossy();
+        s.encode_utf16().count() + s.matches(['\\', '"']).count() + 3
+    };
+    let length =
+        quoted(executable.as_os_str()) + arguments.iter().map(|a| quoted(a)).sum::<usize>();
+    if length <= limit {
+        return Ok((arguments, None));
+    }
+    // rustc reads one UTF-8 argument per line and does not expand `@` inside
+    // the file, so anything else stays on the command line.
+    let lines: Option<Vec<&str>> = arguments
+        .iter()
+        .map(|a| a.to_str())
+        .map(|a| {
+            a.filter(|a| {
+                !a.is_empty() && a.trim() == *a && !a.contains(['\n', '\r']) && !a.starts_with('@')
+            })
+        })
+        .collect();
+    let Some(lines) = lines else {
+        debug!("command line of {length} units is too long, but cannot go into a response file");
+        return Ok((arguments, None));
+    };
+    let mut file = tempfile::Builder::new()
+        .prefix("sccache-rustc-")
+        .suffix(".args")
+        .tempfile()?;
+    std::io::Write::write_all(&mut file, lines.join("\n").as_bytes())?;
+    let path = file.into_temp_path();
+    let mut at = OsString::from("@");
+    at.push(path.as_os_str());
+    trace!(
+        "command line of {length} units passed in {}",
+        path.display()
+    );
+    Ok((vec![at], Some(path)))
+}
